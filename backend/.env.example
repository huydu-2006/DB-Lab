# ---- Backend runtime ----
# SQLAlchemy URL; the schema is created by sql/01_schema.sql
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/bk88_stadium

# Comma-separated allowed browser origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Clerk (production auth) ----
# When CLERK_JWKS_URL is set, Bearer tokens are Clerk RS256 session JWTs
# (verified against this JWKS endpoint) and the dev endpoints are OFF.
# Get both values from the Clerk dashboard:
#   JWKS:  https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#   Issuer: https://<your-instance>.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# ---- Dev fallback auth (only used while CLERK_JWKS_URL is empty) ----
# Local HS256 tokens minted by /api/auth/dev/* so the whole sign-in/sign-up
# flow runs against MySQL without a Clerk account. Never use in production.
DEV_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
TOKEN_EXPIRE_SECONDS=43200
