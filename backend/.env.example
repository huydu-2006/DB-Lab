# SQLAlchemy URL for SQL Server via pyodbc (ODBC Driver 18).
# odbc_connect holds the URL-encoded ODBC connection string.
# App database (created by sql/01_schema.sql):
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3Dlocalhost%5CSQLEXPRESS%3BDATABASE%3Dbk88_stadium%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes

# Comma-separated allowed browser origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Clerk (production auth) ----
# When CLERK_JWKS_URL is set, Bearer tokens are Clerk RS256 session JWTs
# (verified against this JWKS endpoint) and the dev endpoints are OFF.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# ---- Dev fallback auth (only used while CLERK_JWKS_URL is empty) ----
# Local HS256 tokens minted by /api/auth/dev/* so the whole sign-in/sign-up
# flow runs against SQL Server without a Clerk account. Never use in production.
DEV_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
TOKEN_EXPIRE_SECONDS=43200
